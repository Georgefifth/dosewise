# FormPilot works WITHOUT any keys — it falls back to a deterministic offline
# "AI" that still produces the full experience. Set these to enable a real LLM.
#
# Any OpenAI-compatible endpoint works (Featherless, OpenRouter, Groq, vLLM…)
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your-key-here
# NOTE: on Featherless, Llama-family models are HF-gated — prefer Qwen/DeepSeek.
LLM_MODEL=Qwen/Qwen3-32B
LLM_MODEL_FALLBACK=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
