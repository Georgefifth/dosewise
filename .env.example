# DoseWise works WITHOUT keys — bundled samples return canned scans and the
# rule engine runs fully offline. Set these to enable real vision+text models.
#
# Any OpenAI-compatible endpoint works (Featherless, OpenRouter, vLLM…)
LLM_BASE_URL=https://api.featherless.ai/v1
LLM_API_KEY=your-key-here

# vision model for label reading — NOTE: Llama-family models are HF-gated on
# Featherless; use Qwen/DeepSeek. Qwen3 needs /no_think (handled in lib/llm.ts).
VL_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
VL_MODEL_FALLBACK=Qwen/Qwen2.5-VL-72B-Instruct

# text model for plain-language explanations
LLM_MODEL=Qwen/Qwen3-32B
LLM_MODEL_FALLBACK=deepseek-ai/DeepSeek-R1-Distill-Llama-70B
